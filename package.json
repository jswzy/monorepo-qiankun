{
  "name": "@demo/monorepo-qiankun",
  "version": "0.0.0",
  "private": true,
  "description": "qiankun 微前端 monorepo：Vue3 主应用 + Vue2/Vue3/React 三个子应用 + 域内公共包",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=18.18.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:main": "pnpm --filter @demo/main-app run dev",
    "dev:order": "pnpm --filter @demo/app-order run dev",
    "dev:product": "pnpm --filter @demo/app-product run dev",
    "dev:report": "pnpm --filter @demo/app-report run dev",
    "build": "pnpm -r run build",
    "build:main": "pnpm --filter @demo/main-app run build",
    "build:order": "pnpm --filter @demo/app-order run build",
    "build:product": "pnpm --filter @demo/app-product run build",
    "build:report": "pnpm --filter @demo/app-report run build",
    "build:packages": "pnpm --filter \"./packages/shared-utils\" --filter \"./packages/ui-package\" run build",
    "preview": "node scripts/serve-dist.mjs",
    "clean": "node scripts/clean.mjs",
    "lint": "eslint . --ext .js,.mjs,.cjs,.ts,.tsx,.vue --cache --cache-location node_modules/.cache/eslint/",
    "lint:fix": "pnpm run lint --fix",
    "format": "prettier --write \"**/*.{js,mjs,cjs,ts,tsx,vue,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,cjs,ts,tsx,vue,json,css,md}\"",
    "typecheck": "pnpm -r run typecheck",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "verify": "pnpm run check:boundaries && pnpm run lint && pnpm run typecheck && pnpm run build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm run build:packages && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@types/node": "^22.10.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-vue": "^9.32.0",
    "playwright": "^1.62.1",
    "prettier": "^3.4.2",
    "typescript": "catalog:",
    "vue-eslint-parser": "^9.4.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
